# Copy to apple-release.env (gitignored) and fill in. Sourced by the release scripts.

# App Store Connect API key (Users and Access → Integrations → App Store Connect API).
ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# Defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# Developer ID signing (direct distribution). Shown by: security find-identity -v -p codesigning
# DEVELOPER_ID_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization (optional; falls back to the ASC_* key above).
# export APPLE_API_KEY="XXXXXXXXXX"
# export APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
# export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# ---- Mac App Store only ----------------------------------------------------
# App record + version being submitted (App Store Connect → App → App Information).
# ASC_APP_ID="0000000000"
# ASC_VERSION_ID="00000000-0000-0000-0000-000000000000"
# Bundle id resource id (asc bundle-ids list), used to create the provisioning profile.
# ASC_BUNDLE_ID_RESOURCE="XXXXXXXXXX"
# Signing identities; auto-detected from the keychain when unset.
# APPSTORE_APP_SIGN_ID="3rd Party Mac Developer Application: Your Name (TEAMID)"
# APPSTORE_INSTALLER_SIGN_ID="3rd Party Mac Developer Installer: Your Name (TEAMID)"
# CSR identity for setup-appstore-signing.sh.
# CSR_COMMON_NAME="Your Name"
# CSR_EMAIL="you@example.com"
# App Review contact (populate-appstore-listing.py).
# ASC_CONTACT_FIRST_NAME="First"
# ASC_CONTACT_LAST_NAME="Last"
# ASC_CONTACT_EMAIL="you@example.com"
# ASC_CONTACT_PHONE="+15555550100"
