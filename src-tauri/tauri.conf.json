{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DictaFlow",
  "version": "0.1.0",
  "identifier": "com.invisionnaire.dictaflow",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Invisionnaire",
    "shortDescription": "Local-first dictation tool",
    "longDescription": "Hold a hotkey, speak, release. DictaFlow transcribes locally with Whisper and cleans up with Ollama."
  }
}
